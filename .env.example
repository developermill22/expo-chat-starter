# Copy to .env and fill in the backend you want. Restart `npx expo start` after edits.
# EXPO_PUBLIC_* values are bundled into the app — only put client-safe keys here.

# Which backend the app boots with: sqlite | firebase | supabase | appwrite
EXPO_PUBLIC_CHAT_BACKEND=sqlite

# --- Firebase (Project settings → General → Your apps → Web app config) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Supabase (Project settings → API) ---
EXPO_PUBLIC_SUPABASE_URL=
# The publishable (or legacy anon) key — never the service_role / secret key.
EXPO_PUBLIC_SUPABASE_KEY=

# --- Appwrite (Console → Overview) ---
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
# Must match the platform you add in the Console (bundle id / package name in app.json).
EXPO_PUBLIC_APPWRITE_PLATFORM=com.example.chatstarter
EXPO_PUBLIC_APPWRITE_DATABASE_ID=chat
# Server key used ONLY by `npm run appwrite:setup` on your machine. Not EXPO_PUBLIC_, never bundled.
APPWRITE_API_KEY=
